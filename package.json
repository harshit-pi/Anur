{
  "name": "anur",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p plugins && tsc --noEmit -p packages/core && tsc --noEmit -p packages/system && tsc --noEmit -p packages/desktop",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test",
    "test:browser": "pnpm --filter @anur/desktop test:browser",
    "prepare": "husky",
    "eval:context": "node evals/context/run.ts",
    "eval:carry": "node evals/carry/start.mjs",
    "eval:app": "node evals/app/run.ts",
    "plugins:feed": "node scripts/plugins.mjs feed",
    "plugins:check": "node scripts/plugins.mjs check",
    "plugins:publish": "node scripts/plugins.mjs publish",
    "upgrade:list": "pnpm outdated --recursive || true",
    "upgrade:latest": "pnpm update --recursive --latest",
    "upgrade:test": "pnpm install && pnpm check && pnpm --filter @anur/desktop build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.6",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.1",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.0"
  }
}
